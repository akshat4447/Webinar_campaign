# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It holds only variable names and non-secret
# defaults, and the blanket rule above was hiding it from every clone,
# which is the one thing it exists not to do.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Stale local SQLite files from before the Postgres migration — never tracked,
# kept out even though the app no longer reads them, so they can't get
# committed by accident.
*.db
*.db-journal
*.db-wal
*.db-shm

.vscode/

# Claude Code's own local tooling — skill reference docs and lock file it
# manages for itself, not part of the application.
/.claude/
skills-lock.json
