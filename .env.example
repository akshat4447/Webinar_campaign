# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://user:password@host:5432/webinar_studio?schema=public"
# Generate each key independently with: openssl rand -hex 32
REGISTRATION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000

# Actual provider credentials; saved integration settings override environment values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_HOST=
LSQ_SENDER_EMAIL=
NETCORE_API_KEY=
NETCORE_FROM_EMAIL=
NETCORE_FROM_NAME=Webinar Team
APOLLO_API_KEY=

# Provider OAuth, required by the providers rather than an operator login.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
ZOOM_WEBHOOK_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=202608
LINKEDIN_ORGANIZATION_URN=

# Optional timers. Enabling them permits actual configured provider operations.
CADENCE_AUTOTICK=false
CADENCE_AUTOTICK_SECONDS=300
ZOOM_AUTOSYNC=false
ZOOM_AUTOSYNC_SECONDS=300
# The shared scheduled worker also honors ZOOM_AUTOSYNC.
# ZOOM_IMPORT_ALL_MEETINGS=true
# LSQ_ZOOM_REGISTERED_FIELD=mx_Zoom_Registered

# Tests create and drop their own databases; never point these at application data.
# TEST_DATABASE_ADMIN_URL=postgresql://user:password@localhost:5432/postgres
