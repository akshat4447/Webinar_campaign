# Copy this file to .env.local and fill in real values there (never commit .env.local).
# .env.local is already gitignored.

# --- Database (required) ---
# A real Postgres connection string — Render's own managed Postgres, Neon,
# Supabase, or any standard Postgres instance all work. Local dev: point this
# at a local Postgres database (e.g. `createdb webinar_studio_dev`).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- LeadSquared (Milestone 2) ---
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
# Your account's assigned API host, e.g. api.leadsquared.com
LSQ_HOST=

# Real LeadSquared user email to send as (SenderType=UserEmailAddress) — needed
# on accounts where SenderType=APICaller has no mail-sending identity configured.
LSQ_SENDER_EMAIL=

# --- Anthropic / Claude (Milestone 3) ---
ANTHROPIC_API_KEY=

# --- Apollo (enrichment + LinkedIn pre-send verification) ---
# Also settable (and DB always wins over this) on the Integrations page.
APOLLO_API_KEY=

# --- Apify (real web-context grounding for enrichment) ---
# DB-only today — set on the Integrations page after deploying. No env
# fallback exists for this one, so it's listed here for awareness only.
# APIFY_API_TOKEN=

# --- Email sending (Milestone 5) ---
# No SMTP/ESP needed — all cadence emails send via LeadSquared's own
# EmailMarketing.svc/SendEmailToLead API, using the LSQ_* credentials above.
# One of the leads in your sandbox account whose email every SEND_MODE=sandbox
# send gets redirected to, regardless of the real recipient.
SEND_ALLOWLIST_LEAD_EMAIL=

# sandbox = every send is redirected to SEND_ALLOWLIST_LEAD_EMAIL regardless of the real recipient.
# live = sends go to the real recipient. Flipping this needs an explicit decision, not a default.
SEND_MODE=sandbox

# --- LinkedIn Events (Milestone 7) ---
# sandbox = publishing simulates all LinkedIn calls; the webhook still processes fixtures end-to-end.
# live = real POSTs to /rest/events, /rest/posts and Lead Sync reads.
# Also settable per-field on the Integrations page (DB wins over env) — once
# connected via "Connect with LinkedIn" there, it defaults to live even with
# this left at sandbox, so this env var mainly matters before a real connection.
LINKEDIN_MODE=sandbox
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only needed if the app runs behind a proxy/tunnel — defaults to <origin>/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=
# Pinned REST version header. Versions sunset aggressively (202508 died Aug 17 2026) — bump consciously.
LINKEDIN_VERSION=202608
LINKEDIN_ORGANIZATION_URN=

# Cadence automation (optional, OFF by default).
# Set CADENCE_AUTOTICK=1 to have the running server fire due sends on a timer,
# so scheduled messages go out without running `npm run cadence:tick` by hand.
# This causes REAL sends — leave it unset unless you mean it. The send window
# and daily limit still apply. For production, prefer GET /api/cron/cadence
# on a schedule instead (Vercel Cron, Render Cron, GitHub Actions, or any
# external scheduler all work — see vercel.json / render.yaml): this timer
# lives in one process and would double up across replicas.
# CADENCE_AUTOTICK=1
# CADENCE_AUTOTICK_SECONDS=300

# Bearer-token secret protecting GET /api/cron/cadence from being triggered
# by anyone who finds the URL. Required in any real deployment that uses that
# endpoint — the route runs unauthenticated if this is left unset.
CRON_SECRET=

# --- One-click sign-up (Milestone 8) ---
# HMAC key signing the one-click registration links in outreach messages.
# Reuses LINKEDIN_CLIENT_SECRET if unset, for a deployment that already has
# one. Set an explicit value in production — the built-in fallback is a
# well-known development-only string.
REGISTRATION_SECRET=

# This app's own public origin, used to build absolute one-click links from
# code with no request to read a Host header from (the cadence tick, CLI
# scripts). Defaults to http://localhost:3000 for local dev.
APP_ORIGIN=

# --- Zoom ---
# User-managed OAuth app (Zoom Marketplace) — Client ID/Secret identify the
# app itself; the operator's own Zoom account is then connected via
# "Connect with Zoom" on Integrations, same three-legged flow as LinkedIn
# above. Also settable per-field on the Integrations page (DB wins over env).
# sandbox = every call returns fixture data; nothing real is created or read.
# live = real POSTs/GETs against api.zoom.us, using the connected account's
# token. Listing/creating meetings and pulling attendance both run
# automatically in the background (see lib/zoomAutosync.ts) once connected.
ZOOM_MODE=sandbox
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Only needed if the app runs behind a proxy/tunnel — defaults to <origin>/api/auth/zoom/callback
ZOOM_REDIRECT_URI=

# Zoom automation (optional, OFF by default).
# Set ZOOM_AUTOSYNC=1 to have the running server, on a timer: create a Zoom
# meeting for any campaign with a name/date but no meeting yet, pull in newly
# created Zoom meetings as draft campaigns, and pull attendance once a
# webinar's date has passed. Requires a real connection (ZOOM_MODE=live).
# ZOOM_AUTOSYNC=1
# ZOOM_AUTOSYNC_SECONDS=300
