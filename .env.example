# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://user:password@host:5432/webinar_studio?schema=public"
# Generate each key independently with: openssl rand -hex 32
REGISTRATION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000

# Operator sign-in. Both are required: with either missing nobody can sign in. Choose a long password.
APP_USERNAME=
APP_PASSWORD=
# Independently generated scheduler bearer secret (32+ random characters). Never use it in query strings.
CRON_SECRET=

# Actual provider credentials; saved integration settings override environment values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_HOST=
LSQ_SENDER_EMAIL=
NETCORE_API_KEY=
NETCORE_FROM_EMAIL=
NETCORE_FROM_NAME=Webinar Team
# Optional: "true" or "false". Left empty, Netcore applies the sending domain's own open and click tracking setting.
NETCORE_OPEN_TRACKING=
NETCORE_CLICK_TRACKING=
# Optional: "true" registers a person when Netcore reports a click on their Studio registration link. Leave off if recipients' mail
# systems scan links: the scanner's click is reported like a person's.
NETCORE_CLICK_REGISTRATION=
APOLLO_API_KEY=

# Provider OAuth, required by the providers rather than an operator login.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
ZOOM_WEBHOOK_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=202608
LINKEDIN_ORGANIZATION_URN=

# Optional timers. Enabling them permits actual configured provider operations.
CADENCE_AUTOTICK=false
CADENCE_AUTOTICK_SECONDS=300
ZOOM_AUTOSYNC=false
ZOOM_AUTOSYNC_SECONDS=300
# The shared scheduled worker also honors ZOOM_AUTOSYNC.
# ZOOM_IMPORT_ALL_MEETINGS=true
# LSQ_ZOOM_REGISTERED_FIELD=mx_Zoom_Registered

# Tests create and drop their own databases; never point these at application data.
# TEST_DATABASE_ADMIN_URL=postgresql://user:password@localhost:5432/postgres
