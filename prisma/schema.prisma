generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  vertical       String
  // `date` is the human-readable display string shown across the app; `scheduledAt`
  // is the real timestamp the picker writes and reminder offsets are computed from.
  date           String
  scheduledAt    DateTime?
  status         String   @default("draft") // draft | live | completed
  // Independent of status: hides a campaign from the main landing grid without
  // deleting it. A live or completed campaign can be archived and unarchived
  // freely; its status is untouched either way.
  archived       Boolean  @default(false)
  description    String?
  zoomLink       String?
  registrationLink String?
  invites        Int?
  registrations  Int?
  attendance     String?
  demoRequests   Int?
  frequency      String   @default("balanced")
  scheduleWindow String   @default("9:00 AM – 6:00 PM IST")
  dailyLimit     Int      @default(500)
  scoringPrompt    String @default("Score each contact 0–100 on how relevant they are to this webinar's topic, weighting title seniority, functional fit, and account vertical match.")
  scoringCriteria  String @default("VP/Director+ in Marketing, Ops, or Admissions; account vertical matches webinar topic; verified email available.")
  scoringThreshold Int    @default(70)
  // Tone/emphasis instructions for per-recipient personalization — editable from the
  // Personalize tab. Correctness guardrails (keep the link, no invented facts, no
  // leftover merge tokens, channel format limits) live in code and are never overridden
  // by this field. Keep the default text in sync with DEFAULT_PERSONALIZATION_PROMPT
  // in lib/personalization.ts.
  personalizationPrompt String @default("Lead with the operational problem their role actually owns — don't open by praising the company or telling the reader how impressive their work is. Vary the angle by seniority: executives care about outcome and risk, directors and heads about process and their team's throughput, managers and individual contributors about the day-to-day mechanics. Vary by function too — a marketing lead and an operations lead should not receive the same framing.")
  cadenceStatus  String   @default("not_started") // not_started | running | paused | stopped
  linkedinMode   String   @default("assisted") // assisted (manual) | automated (simulated bot)
  simulatedNow   DateTime?
  attendanceImportedAt DateTime?
  lsqListId      String?

  // --- LinkedIn Event integration (lib/linkedin/) ---
  // lifecycle: form_pending_review → creating → created_unpublished → published
  // (or failed / canceled). Null until someone publishes this webinar to LinkedIn.
  linkedinEventUrn    String?
  linkedinPostUrn     String?
  linkedinRegFormUrn  String?
  linkedinEventStatus String?
  linkedinEventError  String?
  linkedinInvitedAt   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts       Contact[]
  templates      Template[]
  cadenceSteps   CadenceStep[]
  cadenceSends   CadenceSend[]
  activityLog    ActivityLogEntry[]
  attentionItems AttentionItem[]
  chatMessages   ChatMessage[]
  personalized   PersonalizedMessage[]
  linkedinRegistrations LinkedinRegistration[]
}

model Contact {
  id          String  @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  email       String?
  account     String
  vertical    String
  title       String
  function    String
  seniority   String
  linkedinId  String?
  missingInfo Boolean @default(false)

  // --- SMS / WhatsApp cadence (lib/channelDelivery.ts) ---
  // phone is the mobile number used by both channels; whatsappOptIn gates the
  // WhatsApp channel entirely (Meta requires explicit opt-in for template
  // messages), smsOptOut records a DND/STOP signal. Both flow in from imports,
  // LeadSquared sync, or the registration form's custom questions.
  phone          String?
  smsOptOut      Boolean @default(false)
  whatsappOptIn  Boolean @default(false)

  score       Int?
  explanation String?
  source      String  @default("Apollo") // LinkedIn | LinkedIn+Apollo | Apollo
  approved    Boolean @default(false)
  // Set the moment a human toggles approval directly (Scoring tab checkbox or bulk
  // action) — re-scoring then leaves this contact's approval alone instead of
  // silently overwriting a human decision with the AI's threshold verdict.
  approvedManually Boolean @default(false)

  lsqLeadId   String?

  // Enrichment. `emailSimulated` marks an address that was *inferred* (Apollo-style
  // pattern guess) rather than supplied by the source data — it may belong to a real
  // person who never opted in, so the send path refuses it until a human sets
  // `emailVerified`. See lib/sendGuard.ts.
  enrichedAt       DateTime?
  enrichmentSource String?
  personaNote      String?
  // Every CSV column that has no first-class field above, kept as JSON so an
  // import never silently discards data the operator supplied.
  extraFieldsJson  String?
  emailSimulated   Boolean @default(false)
  emailVerified    Boolean @default(false)

  attended     Boolean @default(false)
  watchMinutes Int?

  // --- LinkedIn outreach pre-flight (lib/apolloVerify.ts) ---
  // Apollo people-match verdict taken BEFORE this contact enters the LinkedIn
  // send queue: verified = still the person/title we targeted; mismatch =
  // Apollo shows a different company/title than our baseline (job change?);
  // not_found = no confident profile match; error = lookup itself failed.
  // The automated bot path refuses to process anything not 'verified'.
  linkedinCheckStatus String?
  linkedinCheckedAt   DateTime?
  linkedinCheckNote   String?

  createdAt   DateTime @default(now())

  cadenceSends CadenceSend[]
  personalized PersonalizedMessage[]

  @@index([campaignId, approved])
}

model AppSetting {
  key   String @id
  value String
}

/// One AI-written message for one contact at one cadence step. Derived from that
/// step's Template (which owns the offer, the link and the compliance copy) —
/// personalization only reshapes the framing. The send path prefers a row here
/// over the shared template, so editing one changes what actually goes out.
model PersonalizedMessage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  stepKey   String // matches Template.key
  channel   String // email | linkedin
  subject   String?
  body      String
  rationale String? // one line on why this angle was chosen for this person

  // The registration link inlined at generation time. Kept so that changing the
  // campaign's link later can be repaired exactly, without a regeneration.
  linkUsed String?

  status      String   @default("draft") // draft | edited | reviewed
  generatedAt DateTime @default(now())
  editedAt    DateTime?
  reviewedAt  DateTime?

  @@unique([campaignId, contactId, stepKey])
  @@index([campaignId, stepKey])
}

model Template {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  key        String // invite | nudge | final | linkedin | attend | noshow | ...
  label      String
  channel    String
  hasSubject Boolean @default(true)
  subject    String?
  body       String

  savedSubject String?
  savedBody    String?
  savedAt      DateTime?

  // Hidden templates stay editable here but drop out of Personalize, and their
  // matching cadence step is disabled so Schedule/Sends reflect the choice.
  hidden Boolean @default(false)

  updatedAt  DateTime @updatedAt

  @@unique([campaignId, key])
}

model CadenceStep {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  key         String
  group       String
  title       String
  timing      String
  channel     String
  desc        String
  toggleable  Boolean @default(true)
  enabled     Boolean @default(true)
  isRoadmap   Boolean @default(false)

  // What causes this step's sends to be queued — distinct from `anchor`, which
  // only says what its due *date* is measured from. The two are genuinely
  // independent: `attend` and `noshow` are both webinar-anchored, but neither
  // can be queued at launch because nothing yet knows who attended.
  //
  //   launch       every eligible approved contact, when the cadence launches
  //   registration one contact at a time, as each registration arrives
  //   attendance   when the attendance report is imported, which is what
  //                partitions the audience into attended / no-show
  //
  // This replaced a hardcoded list of step keys in lib/cadence.ts. That list
  // could not describe a step the user invented, so a step added in the planner
  // rendered correctly and then silently never sent.
  trigger     String  @default("launch") // launch | registration | attendance

  // Editable schedule. The offset is signed and resolved against `anchor`:
  //   launch  — relative to when the cadence is launched (pre-registration steps)
  //   webinar — relative to campaign.scheduledAt (reminders, post-event follow-ups)
  //   event   — fired by something happening (a registration), not a clock
  offsetValue Int     @default(0)
  offsetUnit  String  @default("days") // days | hours
  anchor      String  @default("launch") // launch | webinar | event

  @@unique([campaignId, key])
}

model CadenceSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  stepKey    String
  dueAt      DateTime
  status     String   @default("queued") // queued | sent | failed | skipped
  sentAt     DateTime?
  error      String?

  createdAt  DateTime @default(now())

  // Prevents double-queuing the same step for the same contact if launch (or the
  // attendance import) runs twice — the app-level dedupe check was a read-then-write
  // race with no constraint backing it.
  @@unique([campaignId, contactId, stepKey])
  @@index([campaignId, status, dueAt])
}

model ActivityLogEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  text       String
  dot        String   @default("var(--accent-500)")
  createdAt  DateTime @default(now())
}

model AttentionItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  icon       String
  color      String
  title      String
  detail     String
  actionsCsv String // comma-separated: retry,skip,fix,view
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  from       String // agent | user
  text       String
  createdAt  DateTime @default(now())
}

/// One Lead Sync webhook delivery for a LinkedIn Event registration. The row
/// doubles as the ingestion queue: the webhook handler inserts fast and
/// responds 200 (LinkedIn retries non-200s), then processing happens via
/// `after()` or scripts/linkedin-process.ts. The unique responseUrn makes
/// redeliveries idempotent, and processedAt=null+error IS the retry marker.
///
/// campaignId is nullable because a registration can arrive for an event this
/// app didn't publish (created manually on LinkedIn) — such rows are stored,
/// marked processed with an explanatory error, and never silently dropped.
model LinkedinRegistration {
  id              String    @id @default(cuid())
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  responseUrn     String    @unique // urn:li:leadGenFormResponse:… — LinkedIn's own idempotency key
  eventUrn        String
  organizationUrn String?
  formUrn         String?
  leadAction      String    @default("CREATED") // CREATED | DELETED
  occurredAt      DateTime?

  registrantName  String?
  registrantEmail String?
  contactId       String?

  processedAt DateTime?
  // Claim stamp for concurrent ingestion runners (webhook after(), CLI drain):
  // a runner atomically flips this from null before working a row, so overlaps
  // can't double-create contacts. Reset to null on retryable failure.
  claimedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@index([claimedAt])
  @@index([campaignId])
}
